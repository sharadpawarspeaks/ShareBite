# ============================================================
# ShareBite Environment Configuration Template (.env.example)
# Note: Keep your real secrets secure and never commit .env to GitHub!
# ============================================================

# Transactional Email Service (Resend - Vercel Serverless Compatible)
# Obtain API key from https://resend.com/api-keys
# Note: Default onboarding@resend.dev is restricted to the account owner's email.
# For production delivery to any inbox, verify your custom domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# AI Food Prioritisation Assistant (Groq - Text Only Expiry Urgency)
# AI is used strictly for prioritising food donations and generating expiry handling advice.
# Uploaded food photographs are NEVER sent to the AI model.
# Obtain API key from https://console.groq.com/keys
GROQ_API_KEY=""

# Map Services
# 1. MapTiler (Primary Map Service - https://cloud.maptiler.com)
MAPTILER_API_KEY=""

# 2. Google Maps (Optional Fallback)
GOOGLE_MAPS_API_KEY=""

# Local Server Port (Automatically handled by Vercel in production)
PORT=3000
