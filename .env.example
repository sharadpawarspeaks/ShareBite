# ============================================================
# ShareBite Environment Configuration Template (.env.example)
# Note: Keep your real secrets secure and never commit .env to GitHub!
# ============================================================

# Transactional Email Service (Vercel Serverless Compatible)
# 1. Resend API (Recommended - https://resend.com/api-keys)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="ShareBite <onboarding@resend.dev>"

# 2. Alternative Generic Email API Key
EMAIL_API_KEY=""

# 3. Optional SMTP Configuration (if not using HTTP email API)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# AI Food Safety Inspector (Groq Llama 3.2 Vision)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Map Services
# MapTiler API Key (https://cloud.maptiler.com)
MAPTILER_API_KEY="your_maptiler_key_here"

# Google Maps API Key (Optional fallback)
GOOGLE_MAPS_API_KEY=""

# Local Server Port (Automatically handled by Vercel in production)
PORT=3000
